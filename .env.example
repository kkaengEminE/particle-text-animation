# ============================================
# Monetization SDK - Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file (it is already in .gitignore).

# --- Google AdSense ---
# Your AdSense publisher client ID (e.g., ca-pub-1234567890123456)
VITE_ADSENSE_CLIENT_ID=

# Individual ad slot IDs from your AdSense dashboard
VITE_ADSENSE_SLOT_HEADER=
VITE_ADSENSE_SLOT_SIDEBAR_LEFT=
VITE_ADSENSE_SLOT_SIDEBAR_RIGHT=
VITE_ADSENSE_SLOT_BOTTOM=
VITE_ADSENSE_SLOT_MODAL=

# --- Lemon Squeezy ---
# Your store slug (the subdomain part of your-store.lemonsqueezy.com)
VITE_LEMON_SQUEEZY_STORE_ID=

# Product ID for one-time purchase
VITE_LEMON_SQUEEZY_PRODUCT_ID=

# Variant ID for subscription plan
VITE_LEMON_SQUEEZY_SUBSCRIPTION_VARIANT_ID=

# --- Vercel Server-Side Only (set in Vercel dashboard, NOT here) ---
# LEMON_SQUEEZY_WEBHOOK_SECRET=
